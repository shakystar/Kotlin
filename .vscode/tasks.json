{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "현재 Kotlin 예제 실행",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "${workspaceFolder}/.vscode/run-kotlin.sh",
        "${workspaceFolder}",
        "${fileDirname}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "clear": true
      }
    }
  ]
}
